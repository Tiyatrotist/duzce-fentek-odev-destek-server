# Düzce FENTEK Ödev Destek — Örnek Ortam Değişkenleri
# Bu dosyayı backend/.env olarak kopyalayın ve kendi rastgele sırlarınızı girin.

# Sunucu Ağ Yapılandırması
PORT=3001
HOST=127.0.0.1

# Kimlik Doğrulama & Güvenlik
# JWT_SECRET: JSON Web Token imzalama anahtarı (en az 32 karakter, rastgele ve benzersiz olmalıdır)
JWT_SECRET=ornek-guclu-ve-rastgele-jwt-anahtari-en-az-32-karakter

# Sınav Havuzu Şifreleme Anahtarı
# SINAV_KEY: Öğretmen soru havuzunun AES-256-GCM ile şifrelenmesi için kullanılan anahtar
SINAV_KEY=ornek-guclu-sinav-havuzu-sifreleme-anahtari-123

# Anahtar Döngüsü (Opsiyonel): Eski anahtarlar virgülle ayrılarak girilebilir
# SINAV_KEY_ESKI=eski-anahtar-1,eski-anahtar-2

# Üretim Modu (Geliştirme için 0 veya boş; Canlı üretim ortamında 1)
# URETIM=1 yapıldığında tohumlama (seed) devre dışı kalır ve KOKENLER zorunlu olur.
URETIM=0
# KOKENLER=https://okul.k12.tr,https://odevdestek.okul.k12.tr

# Veritabanı Yolu
DB_PATH=./odevagi.db

# Video Depolama ve Karantina Klasörü
VIDEO_STORE=./video-depo

# AI Moderasyon ve Eğitim Asistanı (Opsiyonel)
# API anahtarı girilmediğinde kural tabanlı ve yerel filtreleme modu etkin kalır.
# AI_SAGLAYICI=anthropic
# AI_MODEL=claude-sonnet-4-5
# AI_API_KEY=
# AI_ZAMANASIMI=20000

# Sohbet & OCR Limitleri
SOHBET_GUNLUK=30
OCR_KUYRUK_MAX=4
OCR_KULLANICI_MAX=2

# Video Limitleri
VIDEO_MAX_MB=100
VIDEO_MAX_SN=300
BEKLEMEDE_AZAMI=3
VIDEO_GUNLUK_DEPO_MB=500
GUVENILIR_GUNLUK=12
NORMAL_GUNLUK=6
YENI_GUNLUK=2
YENI_HESAP_GUN=3
VIDEO_JOB_TIMEOUT_SN=120
VIDEO_QUEUE_CONCURRENCY=2

# Hız & Spam Koruması
GIRIS_DENEME=10
KAYIT_SAATLIK=100
